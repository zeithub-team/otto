# Copy to `.env` (never commit it).

# --- Ollama -----------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:30b
# Optional: model used only when a message contains images
# OLLAMA_VISION_MODEL=
# DEBUG_OLLAMA=1

# --- Server -----------------------------------------------------------------
# Standalone/dev server port (web UI expects 8000 in dev).
OTTO_PORT=8000
# Folder that relative project paths resolve against (default: ./workspace).
# Use forward slashes on Windows.
# WORKSPACE_ROOT=C:/Users/you/Projects
# SQLite file (default: ./data/app.db in dev, %APPDATA%/zeithub.otto/app.db packaged).
# OTTO_DB=
