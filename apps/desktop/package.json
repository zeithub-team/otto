{
  "name": "@otto/desktop",
  "version": "0.1.8",
  "private": true,
  "description": "zeithub.otto — Electron shell and embedded local server",
  "author": "zeithub.team",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:renderer": "node scripts/build-renderer.mjs",
    "server": "npm run build && node dist/server/index.js",
    "dev": "npm run build && electron . --dev",
    "start": "npm run build && npm run build:renderer && electron .",
    "pack:win": "npm run build && npm run build:renderer && electron-builder --win --dir",
    "dist:win": "npm run build && npm run build:renderer && electron-builder --win nsis && node scripts/release.mjs",
    "dist:local": "npm run build && npm run build:renderer && node scripts/dist-local.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test": "npm run build && node --test \"dist/server/__tests__/*.test.js\"",
    "installer-assets": "node scripts/make-installer-assets.mjs",
    "dist:store": "npm run build && npm run build:renderer && node scripts/dist-store.mjs",
    "store-assets": "node scripts/make-store-assets.mjs",
    "dist:mac": "npm run build && npm run build:renderer && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "team.zeithub.otto",
    "productName": "zeithub.otto",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/__tests__/**",
      "renderer/**/*",
      "skills/**/*",
      "skills-library/**/*",
      "assets/**/*",
      "!assets/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "zeithub.otto",
      "artifactName": "zeithub-otto-setup-${version}.exe",
      "include": "installer/installer.nsi",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "installerSidebar.bmp",
      "installerHeader": "installerHeader.bmp",
      "installerIcon": "../assets/icon.ico",
      "uninstallerIcon": "../assets/icon.ico",
      "installerHeaderIcon": "../assets/icon.ico",
      "language": "1049",
      "runAfterFinish": true
    },
    "electronVersion": "31.7.7",
    "npmRebuild": false,
    "appx": {
      "applicationId": "ZeithubOtto",
      "displayName": "zeithub.otto",
      "backgroundColor": "#070909",
      "showNameOnTiles": false,
      "languages": [
        "ru-RU",
        "en-US",
        "az-Latn-AZ",
        "ka-GE",
        "it-IT",
        "es-ES"
      ],
      "artifactName": "zeithub-otto-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "zeithub-otto-${version}-${arch}.${ext}",
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "zeithub.otto ${version}",
      "artifactName": "zeithub-otto-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "mammoth": "^1.13.0",
    "mysql2": "^3.24.5",
    "node-sqlite3-wasm": "^0.8.60",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0",
    "undici": "^6.29.0",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
